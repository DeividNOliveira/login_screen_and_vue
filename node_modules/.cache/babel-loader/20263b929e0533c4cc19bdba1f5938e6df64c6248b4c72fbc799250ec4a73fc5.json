{"ast":null,"code":"import { ref } from \"vue\";\nexport default {\n  __name: 'App',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const name = ref(\"\");\n    const password = ref(\"\");\n    const message = ref(\"\");\n    console.log(\"name: \", name.value);\n    console.log(\"password\", password.value);\n    const loginForm = () => {\n      if (name.value && password.value) {\n        message.value = \"Deu certo!\";\n      } else {\n        message.value = \"Preencha todos os campos novamente...\";\n      }\n    };\n    const __returned__ = {\n      name,\n      password,\n      message,\n      loginForm,\n      ref\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","name","password","message","console","log","value","loginForm"],"sources":["/home/usuario/screen_login_value/src/App.vue"],"sourcesContent":["<template>\n  <div id=\"app\">\n    <title>Página estática</title>\n    <form @submit.prevent=\"loginForm\">\n      <label for=\"name\">Nome:</label>\n      <input\n        type=\"text\"\n        id=\"name\"\n        v-model=\"name\"\n        placeholder=\"Digite seu nome\"\n        required\n      />\n\n      <label for=\"password\">Senha:</label>\n      <input\n        type=\"password\"\n        id=\"password\"\n        v-model=\"senha\"\n        placeholder=\"Digite sua senha\"\n      />\n      <button type=\"submit\">Enviar</button>\n\n      <div id=\"message\">{{ message }}</div>\n    </form>\n  </div>\n</template>\n\n<script setup>\nimport { ref } from \"vue\";\n\nconst name = ref(\"\");\nconst password = ref(\"\");\nconst message = ref(\"\");\n\nconsole.log(\"name: \", name.value);\nconsole.log(\"password\", password.value);\n\nconst loginForm = () => {\n  if (name.value && password.value) {\n    message.value = \"Deu certo!\";\n  } else {\n    message.value = \"Preencha todos os campos novamente...\";\n  }\n};\n</script>\n\n<style>\n#app {\n  font-family: Avenir, Helvetica, Arial, sans-serif;\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n  text-align: center;\n  color: #2c3e50;\n  margin-top: 60px;\n}\n</style>\n"],"mappings":"AA4BA,SAASA,GAAG,QAAQ,KAAK;;;;;;;IAEzB,MAAMC,IAAI,GAAGD,GAAG,CAAC,EAAE,CAAC;IACpB,MAAME,QAAQ,GAAGF,GAAG,CAAC,EAAE,CAAC;IACxB,MAAMG,OAAO,GAAGH,GAAG,CAAC,EAAE,CAAC;IAEvBI,OAAO,CAACC,GAAG,CAAC,QAAQ,EAAEJ,IAAI,CAACK,KAAK,CAAC;IACjCF,OAAO,CAACC,GAAG,CAAC,UAAU,EAAEH,QAAQ,CAACI,KAAK,CAAC;IAEvC,MAAMC,SAAS,GAAGA,CAAA,KAAM;MACtB,IAAIN,IAAI,CAACK,KAAK,IAAIJ,QAAQ,CAACI,KAAK,EAAE;QAChCH,OAAO,CAACG,KAAK,GAAG,YAAY;MAC9B,CAAC,MAAM;QACLH,OAAO,CAACG,KAAK,GAAG,uCAAuC;MACzD;IACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}